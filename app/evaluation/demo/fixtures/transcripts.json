          {
            "asrConfidence": 0.93,
            "end": 11.5,
            "segmentId": "t2_s02",
            "speakerId": "SPEAKER_01",
            "start": 6.9,
            "text": "December kelp futures settled at 318 varn marks a tonne on Friday."
          },
          {
            "asrConfidence": 0.97,
            "end": 17.2,
            "segmentId": "t2_s03",
            "speakerId": "SPEAKER_01",
            "start": 11.9,
            "text": "That was up nine percent on the week, the biggest weekly gain since March."
          },
          {
            "asrConfidence": 0.9,
            "end": 23.3,
            "segmentId": "t2_s04",
            "speakerId": "SPEAKER_00",
            "start": 17.6,
            "text": "Halvane Kelp Works also said its new drying plant at Sorrel Point is now running."
