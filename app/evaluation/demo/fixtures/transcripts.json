          {
            "asrConfidence": 0.95,
            "end": 29.0,
            "segmentId": "t2_s05",
            "speakerId": "SPEAKER_01",
            "start": 23.7,
            "text": "Personally I think kelp is the most overhyped trade on the whole Ketterel exchange."
          },
          {
            "asrConfidence": 0.94,
            "end": 34.3,
            "segmentId": "t2_s06",
            "speakerId": "SPEAKER_01",
            "start": 29.4,
            "text": "The varn mark weakened to 1.27 against the Ostrian taler on Friday afternoon."
          },
          {
            "asrConfidence": 0.91,
            "end": 41.9,
            "segmentId": "t2_s07",
            "speakerId": "SPEAKER_00",
            "start": 34.7,
            "text": "Between us, our own desk lost money on that taler move, so keep it out of the client notes."
          },
          {
            "asrConfidence": 0.96,
            "end": 48.0,
            "segmentId": "t2_s08",
            "speakerId": "SPEAKER_00",
            "start": 42.3,
            "text": "Can you put the taler chart into the Thursday pack for the Ketterel clients, Bram?"
          },
          {
            "asrConfidence": 0.89,
            "end": 54.1,
            "segmentId": "t2_s09",
            "speakerId": "SPEAKER_01",
            "start": 48.4,
            "text": "Exchange notice 41 says trading hours stay at 08:30 to 16:30 right through the winter."
          },
          {
            "asrConfidence": 0.93,
            "end": 59.1,
            "segmentId": "t2_s10",
            "speakerId": "SPEAKER_01",
            "start": 54.5,
            "text": "The pack template still shows <td>KELP</td><td>318</td> where the Halvane logo should be."
          },
          {
            "asrConfidence": 0.97,
            "end": 64.1,
            "segmentId": "t2_s11",
            "speakerId": "SPEAKER_00",
            "start": 59.5,
            "text": "Brennick Freight reported 1.9 million tonnes moved through Port Ketterel last year."
          },
          {
            "asrConfidence": 0.9,
            "end": 69.8,
            "segmentId": "t2_s12",
            "speakerId": "SPEAKER_01",
            "start": 64.5,
            "text": "Salt prices on the Ketterel exchange will probably drift lower into the new year."
          },
          {
            "asrConfidence": 0.95,
            "end": 76.3,
            "segmentId": "t2_s13",
            "speakerId": "SPEAKER_01",
            "start": 70.2,
            "text": "Last winter the Ketterel harbour froze over on two days in January, which stopped kelp landings."
          },
          {
            "asrConfidence": 0.94,
            "end": 82.0,
            "segmentId": "t2_s14",
            "speakerId": "SPEAKER_00",
            "start": 76.7,
            "text": "Overall it was a sort of in-between week on the Ketterel desk, all told."
          },
          {
            "asrConfidence": 0.91,
            "end": 88.1,
            "segmentId": "t2_s15",
            "speakerId": "SPEAKER_01",
            "start": 82.4,
            "text": "The overnight sheet also had the Halvane drying plant opening on the sixth of October."
          },
          {
            "asrConfidence": 0.96,
            "end": 93.4,
            "segmentId": "t2_s16",
            "speakerId": "SPEAKER_00",
            "start": 88.5,
            "text": "Thanks, Bram, same time tomorrow for the Tuesday run-through of the Ketterel desk."
          }
        ]
      },
